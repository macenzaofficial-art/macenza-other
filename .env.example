# Supabase Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here
# Optional server-side service role key for API routes
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# hCaptcha Keys
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key-here
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key-here
